generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}


model User {
  id          String                          @id @default(uuid(4))
  clerkId     String       @map("clerk_id")   @unique

  // tag         String                        @unique
  email       String                          @unique
  firstName   String       @map("first_name")
  lastName    String       @map("last_name")
  username    String
  imageUrl    String       @map("image_url")

  // Last date when user was online
  lastSeen    DateTime     @map("last_seen")  @default(now())
  createdAt   DateTime     @map("created_at") @default(now())

  memberships RoomMember[]
  messages    Message[]
}

model RoomMember {
  id         String                              @id @default(uuid(4))
  userId     String         @map("user_id")
  roomId     String         @map("room_id")

  lastReadAt DateTime       @map("last_read_at") @default(now())

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  room       Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)

  role       RoomMemberRole                      @default(MEMBER)
  @@unique([userId, roomId])
}

model Room {
  id              String                                @id @default(uuid(4))
  type            RoomType
  name            String                                @default("Group room")
  avatarUrl       String       @map("avatar_url")       @default("")
  avatarPublicId  String       @map("avatar_public_id") @default("")

  createdByUserId String
  memberships     RoomMember[]
  messages        Message[]

  createdAt       DateTime     @map("created_at")       @default(now())
}

model Message {
  id               String                                   @id @default(uuid(4))
  senderId         String       @map("sender_id")
  roomId           String       @map("room_id")
  content          String?

  replyToMessageId String?      @map("reply_to_message_id")
  replyToMessage   Message?     @relation("MessageReply", fields: [replyToMessageId], references: [id])
  replies          Message[]    @relation("MessageReply")

  createdAt        DateTime     @map("created_at")          @default(now())
  updatedAt        DateTime     @map("updated_at")          @updatedAt
  isDeleted        Boolean      @map("is_deleted")          @default(false)

  attachments      Attachment[]

  Room             Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender           User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@index([senderId])
}

model Attachment  {
  id        String                      @id @default(uuid(4))
  messageId String   @map("message_id")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  url       String
  key       String                      @unique
  name      String
  size      Int
  type      String

  createdAt DateTime                    @default(now())
}

enum RoomMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum RoomType {
  DIRECT
  GROUP
}
